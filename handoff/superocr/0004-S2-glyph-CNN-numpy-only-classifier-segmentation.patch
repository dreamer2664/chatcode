+        "seed": args.seed, "per_class": len(y) // len(CHARS),
+        "train_samples": int(len(ytr)), "val_samples": int(len(yva)),
+        "epochs": args.epochs, "final_val_acc": round(float(val_acc), 4),
+        "train_seconds": round(seconds, 1), "weights_bytes": size,
